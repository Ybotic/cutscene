OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
WHISPER_MODEL=base
WHISPER_DEVICE=auto
MAX_VIDEO_SECONDS=7200
MAX_DOWNLOAD_HEIGHT=1080
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=8
MAX_JOB_RETRIES=1
JOB_RETENTION_DAYS=7
RENDER_WORKERS=1
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional email notifications; leave SMTP_HOST/SMTP_FROM empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PUBLIC_API_ORIGIN=http://localhost:8000
# Optional: use an absolute path if FFmpeg is not on PATH.
# FFMPEG_BINARY=/absolute/path/to/ffmpeg
